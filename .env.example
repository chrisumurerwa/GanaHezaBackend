# GanaHeza Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── PostgreSQL (single connection string) ─────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/ganaheza_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=ganaheza_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Storage Provider ──────────────────────────────────────────────────────────
# Controls where uploaded product images are stored.
# Options:
#   local       — saves files to backend/uploads/products/ (default, no extra setup)
#   cloudinary  — uploads to Cloudinary CDN (requires credentials below)
STORAGE_PROVIDER=local

# ── Cloudinary (only required when STORAGE_PROVIDER=cloudinary) ───────────────
# Create a free account at https://cloudinary.com and find these in your dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
